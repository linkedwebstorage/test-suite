@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix lws: <https://w3c.github.io/lws-protocol/test-vocab#> .

<>
  rdf:type mf:Manifest ;
  rdfs:label "Container Representation and Pagination" ;
  rdfs:comment "lws10-core container model, membership, and pagination" ;
  mf:entries (
    <#container-representation>
    <#item-description-fields>
    <#containment-up-link>
    <#empty-container-items>
    <#pagination-links>
    <#pagination-traversal>
  ) .

<#container-representation>
  rdf:type lws:ProtocolTest ;
  mf:name "Container representation shape" ;
  rdfs:comment "A container GET returns @context/id/type/totalItems/items as application/lws+json" ;
  lws:specSection "7" ;
  lws:conformanceLevel "MUST" ;
  lws:category "containers" ;
  lws:testImplementation "tests/containers.test.js#containerRepresentation" .

<#item-description-fields>
  rdf:type lws:ProtocolTest ;
  mf:name "Contained resource description fields" ;
  rdfs:comment "Each item has id, type, mediaType (for DataResources), size, and modified" ;
  lws:specSection "7" ;
  lws:conformanceLevel "MUST" ;
  lws:category "containers" ;
  lws:testImplementation "tests/containers.test.js#itemDescriptionFields" .

<#containment-up-link>
  rdf:type lws:ProtocolTest ;
  mf:name "Containment expressed via rel=up" ;
  rdfs:comment "Non-root resources carry a Link rel=\"up\" to their parent" ;
  lws:specSection "7" ;
  lws:conformanceLevel "MUST" ;
  lws:category "containers" ;
  lws:testImplementation "tests/containers.test.js#containmentUpLink" .

<#empty-container-items>
  rdf:type lws:ProtocolTest ;
  mf:name "Empty container has empty items" ;
  rdfs:comment "An empty container has totalItems 0 and an empty items array" ;
  lws:specSection "7" ;
  lws:conformanceLevel "MUST" ;
  lws:category "containers" ;
  lws:testImplementation "tests/containers.test.js#emptyContainerEmptyItems" .

<#pagination-links>
  rdf:type lws:ProtocolTest ;
  mf:name "Pagination Link relations" ;
  rdfs:comment "A paginated container carries first/next Link headers; totalItems is the full count" ;
  lws:specSection "6.2" ;
  lws:conformanceLevel "SHOULD" ;
  lws:category "containers" ;
  lws:testImplementation "tests/containers.test.js#paginationLinks" .

<#pagination-traversal>
  rdf:type lws:ProtocolTest ;
  mf:name "Pagination traversal is complete" ;
  rdfs:comment "Following rel=\"next\" reassembles the full membership" ;
  lws:specSection "6.2" ;
  lws:conformanceLevel "SHOULD" ;
  lws:category "containers" ;
  lws:testImplementation "tests/containers.test.js#paginationTraversal" .
